{
  "name": "alertick",
  "version": "0.0.4",
  "description": "ALERtick - Uptick Analytics Reporter",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node standalone-server.js",
    "build:mac": "./create-macos-app.sh",
    "build:electron": "electron-builder --mac",
    "build:electron-universal": "electron-builder --mac --universal",
    "publish": "electron-builder --mac --publish always"
  },
  "author": "John Bell @ Uptick",
  "license": "Proprietary",
  "repository": {
    "type": "git",
    "url": "https://github.com/sixcupsofcoffee/alertick.git"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "electron-updater": "^6.6.2",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "electron": "^39.1.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.yourcompany.alertick",
    "productName": "ALERtick",
    "publish": [
      {
        "provider": "github",
        "owner": "sixcupsofcoffee",
        "repo": "alertick"
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "identity": null,
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "files": [
      "main.js",
      "standalone-server.js",
      "public/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    }
  }
}
