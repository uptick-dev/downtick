{
  "name": "downtick",
  "version": "1.0.0",
  "description": "Downtick - Analytics Reporter",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node standalone-server.js",
    "build:mac": "./create-macos-app.sh",
    "build:electron": "electron-builder --mac",
    "build:electron-universal": "electron-builder --mac --universal",
    "build:electron-unsigned": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "publish": "electron-builder --mac --publish always"
  },
  "author": "John Bell",
  "license": "Proprietary",
  "repository": {
    "type": "git",
    "url": "https://github.com/uptick-dev/downtick.git"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "electron-updater": "^6.6.2",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "electron": "^39.1.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.yourcompany.downtick",
    "productName": "Downtick",
    "publish": [
      {
        "provider": "github",
        "owner": "uptick-dev",
        "repo": "downtick"
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": {
        "teamId": "M3Q9SM4LDD"
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "files": [
      "main.js",
      "standalone-server.js",
      "public/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    }
  }
}
